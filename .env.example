# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins. The web app runs on 5173.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/cookiepot

# ---- Auth ----
# Both must be >= 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty in development: the mailer then logs the message
# instead of sending it, so no real key is needed to run locally.
RESEND_API_KEY=
MAIL_FROM="Cookiepot <onboarding@resend.dev>"

# ---- Logging ----
# error | warn | info | http | debug
LOG_LEVEL=debug

# ---- AI ----
# Empty key => canned answers from src/lib/ai/mock-data (deterministic, free).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The cheap gatekeeper that checks a photo is even food.
OPENAI_SMALL_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# auto = real when a key is set, canned otherwise | mock | openai
AI_PROVIDER=auto

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
