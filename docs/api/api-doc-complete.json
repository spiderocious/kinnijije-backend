    {
      "name": "Extraction (async)",
      "description": "Photo and receipt reading. **Every one of these returns 202 immediately with a job id** — nothing waits on a model.\n\nTwo stages: a CHEAP validity check on a small model (is this even food?), then the expensive extraction only on photos that passed.",
      "item": [
        {
          "name": "POST /extraction/check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_v1}}/extraction/check",
              "host": [
                "{{api_v1}}"
              ],
              "path": [
                "extraction",
                "check"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_ids\": [\n    \"{{file_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /extraction/photos",
          "request": {
            "method": "POST",
