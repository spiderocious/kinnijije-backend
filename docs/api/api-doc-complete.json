  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Capture ids so later requests in each folder just work.",
          "const ct = pm.response.headers.get('Content-Type') || '';",
          "if (pm.response.code < 300 && ct.includes('application/json')) {",
          "  const body = pm.response.json();",
          "  const d = body.data;",
          "  if (d && d.tokens) {",
          "    pm.collectionVariables.set('access_token', d.tokens.access_token);",
          "    pm.collectionVariables.set('refresh_token', d.tokens.refresh_token);",
          "  }",
          "  if (Array.isArray(d) && d.length > 0 && d[0].id) {",
          "    const url = pm.request.url.toString();",
          "    if (url.includes('/stock')) pm.collectionVariables.set('stock_id', d[0].id);",
          "    if (url.includes('/meals')) pm.collectionVariables.set('meal_id', d[0].meal ? d[0].meal.id : d[0].id);",
          "  }",
          "  if (d && d.items && Array.isArray(d.items) && d.items.length > 0 && d.items[0].id) {",
          "    pm.collectionVariables.set('market_id', d.items[0].id);",
          "  }",
          "  if (d && d.id && String(d.id).includes('_')) {",
          "    if (String(d.id).startsWith('f_')) pm.collectionVariables.set('file_id', d.id);",
          "    if (d.type && d.status) pm.collectionVariables.set('job_id', d.id);",
          "  }",
          "  if (d && d.file && d.file.id) pm.collectionVariables.set('file_id', d.file.id);",
          "}",
          "",
          "pm.test('uses the { data } / { error } envelope', function () {",
          "  if (pm.response.code === 204) return;",
          "  if (!ct.includes('application/json')) return;",
          "  const b = pm.response.json();",
          "  pm.expect(b).to.satisfy(function (x) {",
          "    return Object.prototype.hasOwnProperty.call(x, 'data') ||",
          "           Object.prototype.hasOwnProperty.call(x, 'error');",
          "  });",
          "});"
        ]
      }
    }
  ],
